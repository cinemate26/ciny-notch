<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CinyNotch.Island.IslandWindow"
        x:ClassModifier="internal"
        Title="Ciny Notch"
        Width="680" Height="420"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowDecorations="None"
        CanResize="False"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        FontFamily="avares://CinyNotch/Assets/Fonts#Satoshi, Segoe UI Variable Text, Segoe UI"
        FontWeight="Light"
        TextOptions.TextRenderingMode="Antialias">

  <Panel x:Name="Root">
    <Border x:Name="Island"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Width="220" Height="34"
            CornerRadius="0,0,17,17"
            BorderThickness="1"
            BoxShadow="0 18 44 0 #70000000, inset 0 1 0 0 #38FFFFFF"
            ClipToBounds="True">

      <!-- Glass tint: barely there, so what's behind shows through the blur (iOS style).
           Text stays readable through its own soft shadow, not a darker glass.
           The real blur sits underneath, in the glass window. -->
      <Border.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
          <GradientStop Offset="0" Color="#21262630" />
          <GradientStop Offset="1" Color="#38121218" />
        </LinearGradientBrush>
      </Border.Background>

      <!-- The rim: light catches the top-left edge and glints again at the bottom-right. -->
      <Border.BorderBrush>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Offset="0" Color="#B3FFFFFF" />
          <GradientStop Offset="0.28" Color="#33FFFFFF" />
          <GradientStop Offset="0.7" Color="#0FFFFFFF" />
          <GradientStop Offset="1" Color="#59FFFFFF" />
        </LinearGradientBrush>
      </Border.BorderBrush>

      <Panel>
        <!-- Frost: a faint white haze so the glass reads as glass even over dark pages. -->
        <Border x:Name="Frost" Background="#12FFFFFF" IsHitTestVisible="False" />

        <!-- Sheen: a soft diagonal highlight across the upper-left of the glass. -->
        <Border x:Name="Sheen" IsHitTestVisible="False">
          <Border.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="70%,100%">
              <GradientStop Offset="0" Color="#26FFFFFF" />
              <GradientStop Offset="0.35" Color="#0AFFFFFF" />
              <GradientStop Offset="0.6" Color="#00FFFFFF" />
            </LinearGradientBrush>
          </Border.Background>
        </Border>

        <!-- Peek: what the closed island shows. Filled in code. -->
        <Panel x:Name="PeekHost" Height="34" VerticalAlignment="Top">
          <Panel.Effect>
            <DropShadowEffect BlurRadius="5" OffsetX="0" OffsetY="1" Color="#000000" Opacity="0.72" />
          </Panel.Effect>
        </Panel>

        <!-- Card: one tab at a time. Fixed size per tab, scaled while the island grows. -->
        <Grid x:Name="Card"
              Width="560" Height="200"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              RowDefinitions="Auto,*"
              Opacity="0">
          <Grid.Effect>
            <DropShadowEffect BlurRadius="6" OffsetX="0" OffsetY="1" Color="#000000" Opacity="0.72" />
          </Grid.Effect>
          <StackPanel x:Name="Tabs" Grid.Row="0" Orientation="Horizontal" Margin="14,12,14,6" />
          <Panel x:Name="ContentHost" Grid.Row="1" />
        </Grid>

        <!-- Alert: a reminder, a finished Claude task, a timer. Filled in code. -->
        <Grid x:Name="AlertCard"
              Width="400" Height="96"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Opacity="0"
              IsVisible="False">
          <Grid.Effect>
            <DropShadowEffect BlurRadius="6" OffsetX="0" OffsetY="1" Color="#000000" Opacity="0.72" />
          </Grid.Effect>
        </Grid>
      </Panel>
    </Border>
  </Panel>
</Window>
